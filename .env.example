# Dev-only: Vite proxies /api to this backend (see vite.config.ts).
# Production uses vercel.json rewrites instead — no CORS in the browser.
VITE_API_BASE_URL=http://127.0.0.1:8000
# VITE_API_BASE_URL=https://livestockprobackend-production-sx8vrz.laravel.cloud

# Optional third-party keys
VITE_OPENWEATHER_API_KEY=
