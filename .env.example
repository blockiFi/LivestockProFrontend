# Dev only: Vite proxies /api to this backend (axios always uses same-origin /api).
VITE_API_BASE_URL=http://127.0.0.1:8000
# VITE_API_BASE_URL=https://livestockprobackend-production-sx8vrz.laravel.cloud

# Optional override for the dev proxy target (falls back to VITE_API_BASE_URL)
# VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Vercel production: do NOT set VITE_API_BASE_URL in Vercel env vars.
# vercel.json rewrites /api to Laravel Cloud — the browser stays same-origin.

# Optional third-party keys
VITE_OPENWEATHER_API_KEY=
