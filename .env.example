# Backend URL for the Vite dev proxy (browser calls /api on localhost; Vite forwards here).
# Use your local Laravel server for local DB, or the production URL to hit cloud API.
VITE_API_BASE_URL=http://127.0.0.1:8000
# VITE_API_BASE_URL=https://livestockprobackend-production-sx8vrz.laravel.cloud

# Optional override for dev proxy only (VITE_API_BASE_URL is used if unset)
# VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Production (Vercel): leave VITE_API_BASE_URL unset — vercel.json rewrites /api to the backend.
# Do NOT set VITE_API_BASE_URL in Vercel env vars unless you host the API on a different domain
# without rewrites (otherwise the browser will hit CORS).

# Optional third-party keys
VITE_OPENWEATHER_API_KEY=
